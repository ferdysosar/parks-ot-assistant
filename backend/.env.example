# Server
PORT=3001
HOST=0.0.0.0

# Repository mode: local-json | postgres
REPOSITORY_DRIVER=local-json

# If true, postgres failures fallback to local-json
REPOSITORY_FALLBACK_LOCAL=true

# PostgreSQL (use DATABASE_URL or discrete PG vars)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/parks_ot_assistant
PGHOST=localhost
PGPORT=5432
PGDATABASE=parks_ot_assistant
PGUSER=postgres
PGPASSWORD=postgres

# Optional: require SSL for remote databases
# DATABASE_SSL=require

# Optional: pool size
PGPOOL_MAX=10

# Optional dataset override for local-json / seed
# OTS_DATA_PATH=../frontend/src/assets/ots-demo.json
# COMPANIES_DATA_PATH=../frontend/src/data/empresas-activos.json
