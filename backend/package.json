{
  "name": "parks-ot-assistant-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:local": "cross-env REPOSITORY_DRIVER=local-json tsx watch src/server.ts",
    "dev:postgres": "cross-env REPOSITORY_DRIVER=postgres tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed:demo:pg": "tsx src/scripts/seed-demo-postgres.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "cross-env": "^10.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
